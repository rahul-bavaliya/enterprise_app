# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

SECRET_KEY=password
FIRST_SUPERUSER=admin@email.com
FIRST_SUPERUSER_PASSWORD=password

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@email.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
